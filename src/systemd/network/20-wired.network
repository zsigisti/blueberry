# DHCP (v4 + v6) on every wired interface. For a static address, add e.g.
# 10-static.network with a Name= match and Address=/Gateway=/DNS= - lower
# number wins.
[Match]
Type=ether

[Network]
DHCP=yes
IPv6AcceptRA=yes

[DHCPv4]
UseDNS=yes
UseNTP=yes
RouteMetric=10

[DHCPv6]
UseDNS=yes

[IPv6AcceptRA]
RouteMetric=10
