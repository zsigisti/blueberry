#!/bin/sh
# initramfs /init, PID 1. With nothing on the cmdline it's a live CLI running
# from RAM; otherwise it switch_roots somewhere.
#
# cmdline:
#   bbtest                run /etc/selftest and power off
#   bbtui                 straight into the installer
#   bbinstall             unattended install, then power off (blueberry.* below)
#   blueberry.live=1      squashfs + overlay root from the boot medium
#   root=live:CDLABEL=ID  which medium for blueberry.live (scans if missing)
#   root=<dev|LABEL|UUID> boot that disk
#   rootfstype= rootflags= init=   the usual (auto, ro, /sbin/init)
#   cryptdevice=<src>:<name>       unlock LUKS before mounting root
#   quiet                 no banner
#   debug                 set -x
#
# This runs under busybox ash. Keep it POSIX.

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root TERM="${TERM:-linux}"
# ash reads $ENV for interactive shells - that's where the prompt comes from
export ENV=/etc/profile

mount -t proc     proc     /proc       2>/dev/null
mount -t sysfs    sysfs    /sys        2>/dev/null
mount -t devtmpfs devtmpfs /dev        2>/dev/null || \
    mount -t tmpfs devtmpfs /dev -o nosuid,mode=0755
mkdir -p /dev/pts /dev/shm /run /tmp /root
mount -t devpts devpts /dev/pts -o nosuid,noexec,gid=5,mode=620 2>/dev/null
mount -t tmpfs  shm    /dev/shm -o nosuid,nodev                 2>/dev/null
mount -t tmpfs  run    /run     -o nosuid,nodev,mode=755        2>/dev/null
chmod 1777 /tmp 2>/dev/null

[ -x /bin/mdev ] && mdev -s 2>/dev/null

# `cmdline foo` -> 1 for a bare flag, the value for foo=bar, nothing if absent
cmdline() {
    for tok in $(cat /proc/cmdline 2>/dev/null); do
        case "$tok" in
            "$1")   echo 1; return ;;
            "$1"=*) echo "${tok#*=}"; return ;;
        esac
    done
}

QUIET=$(cmdline quiet)
DEBUG=$(cmdline debug)
BBTEST=$(cmdline bbtest)
BBINSTALL=$(cmdline bbinstall)
BBTUI=$(cmdline bbtui)
LIVE=$(cmdline blueberry.live)
ROOT=$(cmdline root)

[ -n "$DEBUG" ] && set -x

hostname -F /etc/hostname 2>/dev/null || hostname blueberry 2>/dev/null

# DHCP on every ethernet interface (type 1). Live/test only - a disk boot
# leaves networking to the real init.
setup_network() {
    ip link set lo up 2>/dev/null
    # NIC drivers probe async, so give the first interface ~3s to show up
    _n=0
    while [ $_n -lt 10 ]; do
        for _p in /sys/class/net/*; do
            iface=${_p##*/}
            [ "$iface" = lo ] && continue
            [ "$(cat "$_p/type" 2>/dev/null)" = "1" ] && _n=99 && break
        done
        [ $_n -eq 99 ] && break
        sleep 0.3; _n=$((_n + 1))
    done
    for _p in /sys/class/net/*; do
        iface=${_p##*/}
        [ "$iface" = lo ] && continue
        [ "$(cat "$_p/type" 2>/dev/null)" = "1" ] || continue
        ip link set "$iface" up 2>/dev/null
        udhcpc -b -i "$iface" -s /etc/udhcpc.script -t 4 -T 1 2>/dev/null &
    done
    # QEMU's SLIRP hands out a fec0:: address that goes nowhere, lookups then
    # prefer the AAAA and downloads hang. No global v6 -> turn v6 off.
    sleep 1
    if ! ip -6 addr show scope global 2>/dev/null | grep -q "inet6"; then
        echo 1 > /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null || true
    fi
}

# dropbear, host keys made on first connect (RAM only). root / blueberry.
start_sshd() {
    [ -x /usr/sbin/dropbear ] || return 0
    mkdir -p /etc/dropbear
    dropbear -R -p 22 2>/dev/null &
}

# keeps retrying on its own if there's no network yet
start_ntpd() {
    ntpd -p 0.pool.ntp.org -p 1.pool.ntp.org 2>/dev/null &
}

# `make test` greps the serial log for BLUEBERRY_TEST=PASS (printed by selftest)
if [ -n "$BBTEST" ]; then
    setup_network
    start_sshd
    start_ntpd
    /etc/selftest
    echo o > /proc/sysrq-trigger 2>/dev/null
    poweroff -f 2>/dev/null
    exec sh
fi

# bbtui is the installer ISO's default entry. Installer exits 0 -> reboot,
# anything else -> a shell, and leaving the shell restarts the installer.
if [ -n "$BBTUI" ]; then
    export TERM=linux
    # printk on top of the TUI confuses its diff renderer and leaves ghost rows
    dmesg -n 1 2>/dev/null || echo 1 > /proc/sys/kernel/printk 2>/dev/null
    while :; do
        setsid cttyhack /usr/bin/blueberry-install && {
            echo "Rebooting into the installed system..."
            sync; sleep 1
            reboot -f 2>/dev/null
        }
        echo
        echo "Installer exited, here's a shell. Exit it to start the installer again."
        setsid cttyhack /bin/sh
    done
fi

# Unattended install, settings from the cmdline, e.g.
#   bbinstall blueberry.target=/dev/sda blueberry.rootpw=secret blueberry.pkgs=vim,git
# test-install.sh waits for the BLUEBERRY_INSTALL= line.
if [ -n "$BBINSTALL" ]; then
    BLUEBERRY_TARGET=$(cmdline blueberry.target); : "${BLUEBERRY_TARGET:=/dev/sda}"
    BLUEBERRY_ROOTPW=$(cmdline blueberry.rootpw); : "${BLUEBERRY_ROOTPW:=blueberry}"
    # no spaces on a cmdline, so commas
    BLUEBERRY_PKGS=$(cmdline blueberry.pkgs | tr ',' ' ')
    BLUEBERRY_HOSTNAME=$(cmdline blueberry.hostname)
    BLUEBERRY_SWAP=$(cmdline blueberry.swap)
    BLUEBERRY_USER=$(cmdline blueberry.user)
    BLUEBERRY_USERPW=$(cmdline blueberry.userpw)
    BLUEBERRY_LUKS=$(cmdline blueberry.luks)
    BLUEBERRY_LUKSPW=$(cmdline blueberry.lukspw)
    BLUEBERRY_LVM=$(cmdline blueberry.lvm)
    # bios | uefi | auto (default: whatever we booted as)
    BLUEBERRY_BOOTLOADER=$(cmdline blueberry.bootloader)
    BLUEBERRY_KEYMAP=$(cmdline blueberry.keymap)
    # ext4 (default) | xfs | btrfs
    BLUEBERRY_FS=$(cmdline blueberry.fs)
    export BLUEBERRY_TARGET BLUEBERRY_ROOTPW BLUEBERRY_PKGS BLUEBERRY_YES=1
    export BLUEBERRY_HOSTNAME BLUEBERRY_SWAP BLUEBERRY_USER BLUEBERRY_USERPW
    export BLUEBERRY_LUKS BLUEBERRY_LUKSPW BLUEBERRY_BOOTLOADER BLUEBERRY_KEYMAP BLUEBERRY_FS BLUEBERRY_LVM
    blueberry-install; rc=$?
    echo "BLUEBERRY_INSTALL_EXIT=$rc"
    [ "$rc" = 0 ] && echo "BLUEBERRY_INSTALL=OK" || echo "BLUEBERRY_INSTALL=FAIL"
    sync; sleep 1   # let the markers reach the serial log before poweroff spam
    echo o > /proc/sysrq-trigger 2>/dev/null
    poweroff -f 2>/dev/null
    exec sh
fi

# cryptdevice=<src>:<name> -> /dev/mapper/<name> for root=. <src> can be a
# node or UUID=/PARTUUID=/LABEL=. Three wrong passphrases and you get the
# live shell instead.
CRYPTDEV=$(cmdline cryptdevice)
if [ -n "$CRYPTDEV" ] && command -v cryptsetup >/dev/null 2>&1; then
    _csrc=${CRYPTDEV%%:*}; _cname=${CRYPTDEV#*:}; : "${_cname:=cryptroot}"
    case "$_csrc" in
        UUID=*|PARTUUID=*|LABEL=*) _r=$(findfs "$_csrc" 2>/dev/null) && [ -n "$_r" ] && _csrc=$_r ;;
    esac
    if [ -b "$_csrc" ]; then
        _n=0
        until cryptsetup open "$_csrc" "$_cname"; do
            _n=$((_n + 1))
            [ "$_n" -ge 3 ] && { echo "init: too many failed unlock attempts" >&2; break; }
            echo "Unlock failed, try again."
        done
    else
        echo "init: LUKS source not found: $_csrc" >&2
    fi
fi

# after LUKS, so LVM-on-LUKS works. no-op without LVM
if command -v vgchange >/dev/null 2>&1; then
    vgchange -ay >/dev/null 2>&1
fi

# blueberry.live=1: find the boot medium, put a tmpfs overlay on its squashfs
# and switch_root into that.
if [ -n "$LIVE" ]; then
    LABEL=""
    case "$ROOT" in live:CDLABEL=*) LABEL=${ROOT#live:CDLABEL=} ;; esac
    for m in loop squashfs overlay isofs cdrom sr_mod usb_storage; do
        modprobe "$m" 2>/dev/null || true
    done
    # The overlay's backing dirs must NOT live under /run. Moving /run into the
    # new root then nests upper/lower inside the overlay itself and
    # switch_root panics ("Attempted to kill init"). /live never gets moved.
    mkdir -p /live/medium /live/rootfs.ro /live/overlay /mnt/root
    # by label, else try every block device (a dd'd USB stick may not keep the label)
    MEDIUM=""
    if [ -n "$LABEL" ]; then
        _d=$(findfs "LABEL=$LABEL" 2>/dev/null) && [ -b "$_d" ] && MEDIUM=$_d
    fi
    _try=0
    while [ -z "$MEDIUM" ] && [ $_try -lt 20 ]; do
        [ -x /bin/mdev ] && mdev -s 2>/dev/null
        for _b in /dev/sr* /dev/sd* /dev/vd* /dev/nvme*n*; do
            [ -b "$_b" ] || continue
            if mount -t iso9660 -o ro "$_b" /live/medium 2>/dev/null \
               || mount -o ro "$_b" /live/medium 2>/dev/null; then
                [ -f /live/medium/live/filesystem.squashfs ] && { MEDIUM=$_b; break; }
                umount /live/medium 2>/dev/null
            fi
        done
        [ -n "$MEDIUM" ] && break
        sleep 0.5; _try=$((_try + 1))
    done
    if [ -n "$MEDIUM" ]; then
        mountpoint -q /live/medium 2>/dev/null \
            || mount -o ro "$MEDIUM" /live/medium 2>/dev/null
        if mount -t squashfs -o ro /live/medium/live/filesystem.squashfs \
                 /live/rootfs.ro 2>/dev/null; then
            mount -t tmpfs -o mode=0755 live-overlay /live/overlay
            mkdir -p /live/overlay/upper /live/overlay/work
            if mount -t overlay overlay \
                 -o lowerdir=/live/rootfs.ro,upperdir=/live/overlay/upper,workdir=/live/overlay/work \
                 /mnt/root 2>/dev/null; then
                # not /run - systemd wants to mount a fresh one
                for d in proc sys dev; do
                    mkdir -p "/mnt/root/$d"
                    mount --move "/$d" "/mnt/root/$d" 2>/dev/null
                done
                # keep the medium reachable after boot. under /lib/live
                # because systemd would cover anything in /run
                mkdir -p /mnt/root/lib/live/medium
                mount --bind /live/medium /mnt/root/lib/live/medium 2>/dev/null
                echo "BLUEBERRY_LIVE_BOOT=OK medium=$MEDIUM"
                # init=/bin/bash works here too, for rescue
                LIVEINIT=$(cmdline init); : "${LIVEINIT:=/sbin/init}"
                exec switch_root /mnt/root "$LIVEINIT"
            fi
        fi
    fi
    echo "init: live medium not found/usable, falling back to live CLI shell" >&2
fi

# root= given: mount it and hand off. Otherwise stay a live system in RAM.
if [ -n "$ROOT" ] && [ -z "$LIVE" ]; then
    ROOTFSTYPE=$(cmdline rootfstype); : "${ROOTFSTYPE:=auto}"
    ROOTFLAGS=$(cmdline rootflags);   : "${ROOTFLAGS:=ro}"
    # /sbin/init is runit-init or systemd depending on the image
    INIT=$(cmdline init);             : "${INIT:=/sbin/init}"
    # the installer writes UUID=; if findfs can't resolve it, let mount try
    case "$ROOT" in
        UUID=*|LABEL=*|PARTUUID=*|PARTLABEL=*)
            _dev=$(findfs "$ROOT" 2>/dev/null) && [ -n "$_dev" ] && ROOT="$_dev" ;;
    esac
    mkdir -p /mnt/root
    # -L too: an absolute symlink like /sbin/init -> /usr/lib/systemd/systemd
    # resolves against *our* root here, so -x fails on it. switch_root gets
    # it right inside the new root.
    if mount -t "$ROOTFSTYPE" -o "$ROOTFLAGS" "$ROOT" /mnt/root 2>/dev/null \
       && { [ -x "/mnt/root$INIT" ] || [ -L "/mnt/root$INIT" ]; }; then
        for d in proc sys dev run; do
            mkdir -p "/mnt/root/$d"
            mount --move "/$d" "/mnt/root/$d" 2>/dev/null
        done
        echo "BLUEBERRY_DISK_BOOT=OK root=$ROOT"
        exec switch_root /mnt/root "$INIT"
    fi
    echo "init: could not boot root=$ROOT, falling back to live shell" >&2
fi

# live CLI from here on
setup_network
start_sshd
start_ntpd

# stop late kernel chatter (i8042 probing etc.) landing on top of the prompt.
# errors still show, and dmesg has the rest
[ -z "$DEBUG" ] && [ -w /proc/sys/kernel/printk ] && echo 4 > /proc/sys/kernel/printk

banner() {
    [ -n "$QUIET" ] && return 0
    cat <<EOF

   _     _                _
  | |__ | |_   _  ___| |__   ___ _ __ _ __ _   _
  | '_ \\| | | | |/ _ \\ '_ \\ / _ \\ '__| '__| | | |
  | |_) | | |_| |  __/ |_) |  __/ |  | |  | |_| |
  |_.__/|_|\\__,_|\\___|_.__/ \\___|_|  |_|   \\__, |
                                           |___/   Linux

  Blueberry Linux — live CLI   ·   kernel $(uname -r)
  Run 'bb-install' to install to disk   ·   'help' for busybox applets.

EOF
}

# A root shell on every active console (monitor and serial/IPMI alike),
# respawned when it exits. getty gives it a controlling tty so job control
# works; -n -l skips the login prompt. bblogin is `bash --login` (plain bash
# here would skip /etc/profile and lose the prompt).
LOGIN_SHELL=/bin/sh
[ -x /usr/bin/bblogin ] && LOGIN_SHELL=/usr/bin/bblogin
run_shell() {
    tty="$1"; baud="$2"
    while : ; do
        banner > "/dev/$tty" 2>/dev/null
        getty -i -n -L -l "$LOGIN_SHELL" "$baud" "$tty" 2>/dev/null
        sleep 0.2
    done
}

CONSOLES=""
if [ -r /sys/class/tty/console/active ]; then
    for c in $(cat /sys/class/tty/console/active); do
        case "$c" in
            tty0) CONSOLES="$CONSOLES tty1" ;;   # VGA: run the shell on tty1
            *)    CONSOLES="$CONSOLES $c"   ;;
        esac
    done
fi
[ -n "$CONSOLES" ] || CONSOLES="tty1"

for c in $CONSOLES; do
    case "$c" in
        ttyS*) run_shell "$c" 115200 & ;;
        *)     run_shell "$c" 0      & ;;
    esac
done

# busybox halt/poweroff/reboot just signal PID 1 (USR1/USR2/TERM), and that's
# us. Do the real thing so a bare `poweroff` works.
trap 'sync; halt -f'     USR1
trap 'sync; poweroff -f' USR2
trap 'sync; reboot -f'   TERM INT

# PID 1 doesn't get to exit
while : ; do wait; sleep 1; done
