#!/bin/sh
# Live CLI smoke test, run by /init on `bbtest`. The last line,
# BLUEBERRY_TEST=PASS|FAIL, is what `make test` greps the serial log for.

PASS=0
FAIL=0

ok()   { PASS=$((PASS + 1)); printf 'PASS: %s\n' "$1"; }
bad()  { FAIL=$((FAIL + 1)); printf 'FAIL: %s\n' "$1"; }

# check <name> <cmd...>: passes if cmd exits 0
check() {
    name="$1"; shift
    if out=$("$@" 2>&1); then
        ok "$name"
    else
        bad "$name"
        printf '      %s\n' "$out"
    fi
}

# grep_check <name> <pattern> <cmd...>: passes if the output matches
grep_check() {
    name="$1"; pat="$2"; shift 2
    if "$@" 2>&1 | grep -q "$pat"; then
        ok "$name"
    else
        bad "$name"
    fi
}

printf '\n=== Blueberry CLI self-test ===\n\n'

check      "busybox present"     test -x /bin/busybox
check      "sh works"            sh -c 'exit 0'
grep_check "echo"        hello   echo hello
grep_check "ls /bin"     busybox ls /bin
grep_check "uname -s"    Linux   uname -s

check      "/proc mounted"       test -f /proc/cpuinfo
check      "/sys mounted"        test -d /sys/class
check      "/dev populated"      test -c /dev/null
grep_check "mount table"  proc   mount

grep_check "ps lists init"  init  ps
check      "uptime readable"      cat /proc/uptime
check      "writable /tmp"        sh -c 'echo hi > /tmp/.t && rm -f /tmp/.t'

grep_check "hostname"  blueberry  hostname

# give DHCP ~8s (QEMU user-net hands out 10.0.2.15)
net_ok=""
i=0
while [ $i -lt 16 ]; do
    for _p in /sys/class/net/*; do
        iface=${_p##*/}
        [ "$iface" = lo ] && continue
        if ip -4 addr show "$iface" 2>/dev/null | grep -q 'inet '; then
            net_ok="$iface"; break
        fi
    done
    [ -n "$net_ok" ] && break
    sleep 0.5; i=$((i + 1))
done
if [ -n "$net_ok" ]; then
    ok "DHCP lease on $net_ok ($(ip -4 addr show "$net_ok" | awk '/inet /{print $2}'))"
else
    bad "DHCP lease (no IPv4 on any NIC after 8s)"
fi

# built-in bonding/dummy drivers make bond0/dummy0 unless the cmdline has
# bonding.max_bonds=0 dummy.numdummies=0. make sure that stuck
if [ ! -e /sys/class/net/bond0 ] && [ ! -e /sys/class/net/dummy0 ]; then
    ok "no phantom bond0/dummy0 interfaces"
else
    bad "phantom interface present: $(ls /sys/class/net | tr '\n' ' ')"
fi

# no netstat needed: port 22 is :0016 and LISTEN is 0A in /proc/net/tcp*
ssh_ok=""
i=0
while [ $i -lt 10 ]; do
    if awk '$2 ~ /:0016$/ && $4 == "0A" {found=1} END{exit !found}' \
         /proc/net/tcp /proc/net/tcp6 2>/dev/null; then
        ssh_ok=1; break
    fi
    sleep 0.5; i=$((i + 1))
done
if [ -n "$ssh_ok" ]; then
    ok "dropbear SSH listening on :22"
else
    bad "dropbear SSH not listening on :22"
fi

# can't count on reaching a real NTP server from CI, so just check it's running
if ps 2>/dev/null | grep -v grep | grep -q '[n]tpd'; then
    ok "ntpd running"
else
    bad "ntpd not running"
fi

# seq has no /bin symlink on purpose: this only passes with
# CONFIG_FEATURE_SH_STANDALONE=y in busybox
if [ ! -e /bin/seq ] && [ "$(seq 3 | tr -d '\n')" = "123" ]; then
    ok "standalone shell (unlinked applet runs by name)"
else
    bad "standalone shell (unlinked applet runs by name)"
fi

# build a tiny package right here, install it into a scratch root, remove it
bp=/tmp/bpwork
rm -rf "$bp"; mkdir -p "$bp/stage/usr/bin" "$bp/root"
printf '#!/bin/sh\necho ok\n' > "$bp/stage/usr/bin/bpmcheck"
chmod 755 "$bp/stage/usr/bin/bpmcheck"
printf 'pkgname = bpmcheck\npkgver = 1-1\n' > "$bp/stage/.PKGINFO"
( cd "$bp/stage" && tar -c .PKGINFO usr | zstd -q > "$bp/p.pkg.tar.zst" ) 2>/dev/null
if BPM_ROOT="$bp/root" bpm install "$bp/p.pkg.tar.zst" >/dev/null 2>&1 \
   && [ -x "$bp/root/usr/bin/bpmcheck" ] \
   && BPM_ROOT="$bp/root" bpm list 2>/dev/null | grep -q bpmcheck \
   && BPM_ROOT="$bp/root" bpm remove bpmcheck >/dev/null 2>&1 \
   && [ ! -e "$bp/root/usr/bin/bpmcheck" ]; then
    ok "bpm install + remove (.pkg.tar.zst)"
else
    bad "bpm install/remove"
fi

printf '\n=== %d passed, %d failed ===\n' "$PASS" "$FAIL"
if [ "$FAIL" -eq 0 ]; then
    printf 'BLUEBERRY_TEST=PASS\n'
else
    printf 'BLUEBERRY_TEST=FAIL\n'
fi
printf '\n'
