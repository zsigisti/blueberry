# /etc/profile for the live CLI

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root
export PS1='\u@\h:\w\$ '
export TERM="${TERM:-linux}"

alias ll='ls -l'
alias la='ls -la'

# PID 1 is our /init script, not a real init. It does trap the signals, but -f
# is the sure thing.
alias poweroff='poweroff -f'
alias reboot='reboot -f'
alias halt='halt -f'

umask 022
cd "$HOME" 2>/dev/null || cd /
