#!/bin/sh
# sv-disable <service>...
# Stops the service and unlinks it from /var/service and /etc/sv/enabled.
# /etc/sv/<name> stays, so sv-enable brings it back.
set -eu

[ $# -ge 1 ] || { echo "usage: sv-disable <service>..." >&2; exit 1; }

for name in "$@"; do
    [ -e "/var/service/$name" ] && sv down "$name" 2>/dev/null || true
    rm -f "/var/service/$name" "/etc/sv/enabled/$name"
    echo "disabled $name"
done
