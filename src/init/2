#!/bin/sh
# runit stage 2: hand over to runsvdir, which never returns.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

mkdir -p /var/service

# link anything in /etc/sv/enabled that isn't already live
for svc in /etc/sv/enabled/*; do
    [ -d "$svc" ] || continue
    name=$(basename "$svc")
    [ -L /var/service/"$name" ] || ln -s "$svc" /var/service/"$name"
done

exec runsvdir -P /var/service 'log: ...........................................................'
