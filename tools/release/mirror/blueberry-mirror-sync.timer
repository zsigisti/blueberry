[Unit]
Description=Periodic Blueberry bpm mirror sync
Documentation=https://github.com/blueberry-linux (wiki: Hosting-a-Mirror)

[Timer]
# every 15 min, jittered so mirrors don't all hit the origin at once
OnBootSec=2min
OnUnitActiveSec=15min
RandomizedDelaySec=2min
Persistent=true

[Install]
WantedBy=timers.target
