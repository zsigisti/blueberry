[Unit]
Description=Sync the Blueberry bpm repo mirror from the origin
Documentation=https://github.com/blueberry-linux (wiki: Hosting-a-Mirror)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# ORIGIN_RSYNC / REPO_DIR go in /etc/default/blueberry-mirror
EnvironmentFile=-/etc/default/blueberry-mirror
ExecStart=/usr/local/bin/blueberry-mirror-sync
# bulk background I/O, stay out of the way
Nice=10
IOSchedulingClass=idle
ProtectSystem=strict
ReadWritePaths=/srv/blueberry-repo
ProtectHome=yes
NoNewPrivileges=yes
