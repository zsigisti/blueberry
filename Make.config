# Build defaults. Copy to Make.local (gitignored) and edit that to override.

ARCH          ?= x86_64
# only x86_64 for now

# Cross prefix, e.g. x86_64-linux-musl-. Empty = host compiler.
CROSS_COMPILE ?=

CC            = $(CROSS_COMPILE)gcc
CXX           = $(CROSS_COMPILE)g++
AR            = $(CROSS_COMPILE)ar
STRIP         = $(CROSS_COMPILE)strip
OBJCOPY       = $(CROSS_COMPILE)objcopy

# busybox/runit/dropbear link dynamically against the host glibc; the glibc
# runtime gets bundled into the image later. We never build a libc here.

JOBS          ?= $(shell nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)

LINUX_VERSION    ?= 6.18.38
BUSYBOX_VERSION  ?= 1.36.1
RUNIT_VERSION    ?= 2.1.2
DROPBEAR_VERSION ?= 2024.86

# Build output goes to ../blueberry-build, outside the source tree.
TOPDIR  := $(CURDIR)
OBJDIR  ?= $(abspath $(TOPDIR)/../blueberry-build)
DESTDIR ?= $(OBJDIR)/rootfs

CFLAGS   ?= -Os -pipe -fstack-protector-strong
CXXFLAGS ?= $(CFLAGS)
LDFLAGS  ?= -Wl,-z,relro,-z,now

# The kernel is pinned and prebuilt; `make` downloads it rather than compiling.
# To change it, bump LINUX_VERSION and/or src/kernel/config and run
# `make kernel-publish` on a build box (`make kernel-rebuild` = compile, no upload).
KERNEL_LOCALVERSION ?= -blueberry
